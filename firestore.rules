rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn() && (!hasProfile() || getUserData().get('isActive', true) == true);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return hasProfile() ? getUserData().get('role', 'CITIZEN') : 'CITIZEN';
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'ADMIN';
    }

    function isVolunteer() {
      return isSignedIn() && (getUserRole() == 'VOLUNTEER' || getUserRole() == 'ADMIN');
    }

    function isCitizen() {
      return isActiveUser();
    }


    // --- USERS COLLECTION SECURITY ---
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());

      allow create: if isSignedIn() &&
        isOwner(userId) &&
        request.resource.data.role == 'CITIZEN' &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.get('isActive', true) == true;

      allow update: if (
        isOwner(userId) &&
        isActiveUser() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'isActive'])
      ) || isAdmin();

      allow delete: if isAdmin();
    }


    // --- ALERTS COLLECTION SECURITY ---
    match /alerts/{alertId} {
      allow read: if (resource != null && resource.data.get('isPublic', true) == true) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }


    // --- INCIDENTS COLLECTION SECURITY ---
    match /incidents/{incidentId} {
      allow read: if isSignedIn() && (
        (resource != null && isOwner(resource.data.reporterId)) ||
        isAdmin() ||
        isVolunteer()
      );

      allow create: if isActiveUser() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'REPORTED';

      allow update: if (
        isOwner(resource.data.reporterId) &&
        isActiveUser() &&
        resource.data.status == 'REPORTED' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'reporterId',
          'status',
          'verifiedBy',
          'verifiedAt',
          'resolutionNotes',
          'resolvedAt'
        ])
      ) || isAdmin();

      allow delete: if isAdmin();
    }


    // --- EMERGENCY REQUESTS COLLECTION SECURITY ---
    match /emergencyRequests/{requestId} {
      allow read: if isSignedIn() && (
        (resource != null && isOwner(resource.data.requesterId)) ||
        (resource != null && resource.data.assignedVolunteerId == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isActiveUser() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.assignedVolunteerId == null &&
        request.resource.data.resolvedAt == null &&
        request.resource.data.resolutionNotes == null;

      allow update: if (
        isOwner(resource.data.requesterId) &&
        isActiveUser() &&
        request.resource.data.status == 'CANCELLED' &&
        (resource.data.status == 'PENDING' || resource.data.status == 'ACKNOWLEDGED') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'requesterId',
          'assignedVolunteerId',
          'resolvedAt',
          'resolutionNotes',
          'createdAt'
        ])
      ) || isAdmin();

      allow delete: if isAdmin();
    }


    // --- SAFE LOCATIONS COLLECTION SECURITY ---
    match /safeLocations/{locationId} {
      // Unauthenticated users and citizens can read active public safe locations
      // Admins can read all safe locations (active or inactive)
      allow read: if (resource != null && resource.data.get('isActive', true) == true) || isAdmin();

      // Only Admins can create safe locations
      allow create: if isAdmin() &&
        request.resource.data.createdBy == request.auth.uid;

      // Only Admins can update safe locations; createdBy and createdAt cannot be altered
      allow update: if isAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt']);

      // Only Admins can delete safe locations
      allow delete: if isAdmin();
    }


    // --- PLACEHOLDER RESTRICTIVE RULES FOR FUTURE COLLECTIONS ---

    match /volunteers/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isActiveUser() && isOwner(userId);
      allow update: if (
        isOwner(userId) &&
        isActiveUser() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    match /responses/{responseId} {
      allow read: if isSignedIn() && (isOwner(resource.data.volunteerId) || isAdmin());
      allow create: if isVolunteer() && request.resource.data.volunteerId == request.auth.uid;
      allow update: if isVolunteer() && isOwner(resource.data.volunteerId);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.recipientUid == 'PUBLIC');
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
