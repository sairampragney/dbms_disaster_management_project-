rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Get current user's profile document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if current authenticated user is active
    function isActiveUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().get('isActive', true) == true;
    }

    // Check if request is made by document owner
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role verification helpers
    function getUserRole() {
      return getUserData().get('role', 'CITIZEN');
    }

    function isAdmin() {
      return isActiveUser() && getUserRole() == 'ADMIN';
    }

    function isVolunteer() {
      return isActiveUser() && (getUserRole() == 'VOLUNTEER' || getUserRole() == 'ADMIN');
    }

    function isCitizen() {
      return isActiveUser();
    }


    // --- USERS COLLECTION SECURITY ---
    match /users/{userId} {
      // Any authenticated active user can read their own profile, Admins can read all profiles
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());

      // New users can create their own profile if signed in and role is strictly CITIZEN
      allow create: if isSignedIn() &&
        isOwner(userId) &&
        request.resource.data.role == 'CITIZEN' &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.get('isActive', true) == true;

      // Users can update their own permitted fields, but CANNOT change role, uid, isActive, or createdAt
      allow update: if (
        isOwner(userId) &&
        isActiveUser() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'isActive', 'createdAt'])
      ) || (
        isAdmin() // Admins can manage user roles and active state
      );

      // Deleting profiles is prohibited except for system admins
      allow delete: if isAdmin();
    }


    // --- PLACEHOLDER RESTRICTIVE RULES FOR FUTURE COLLECTIONS ---

    // Alerts collection (Public read, Admin create/update)
    match /alerts/{alertId} {
      allow read: if true; // Public alerts feed
      allow create, update, delete: if isAdmin();
    }

    // Incidents collection
    match /incidents/{incidentId} {
      allow read: if isSignedIn() && (isOwner(resource.data.reporterId) || isAdmin() || isVolunteer());
      allow create: if isActiveUser() && request.resource.data.reporterId == request.auth.uid;
      allow update: if (
        isOwner(resource.data.reporterId) &&
        isActiveUser() &&
        resource.data.status == 'REPORTED' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'verifiedBy', 'verifiedAt'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Emergency Requests collection
    match /emergencyRequests/{requestId} {
      allow read: if isSignedIn() && (isOwner(resource.data.requesterId) || isAdmin() || isVolunteer());
      allow create: if isActiveUser() && request.resource.data.requesterId == request.auth.uid;
      allow update: if (
        isOwner(resource.data.requesterId) &&
        isActiveUser() &&
        resource.data.status == 'PENDING' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'assignedVolunteerId'])
      ) || isVolunteer() || isAdmin();
      allow delete: if isAdmin();
    }

    // Safe Locations collection (Public read, Admin create/update)
    match /safeLocations/{locationId} {
      allow read: if true; // Public safe location directory
      allow create, update, delete: if isAdmin();
    }

    // Volunteers collection
    match /volunteers/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isActiveUser() && isOwner(userId);
      allow update: if (
        isOwner(userId) &&
        isActiveUser() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Community Responses collection
    match /responses/{responseId} {
      allow read: if isSignedIn() && (isOwner(resource.data.volunteerId) || isAdmin());
      allow create: if isVolunteer() && request.resource.data.volunteerId == request.auth.uid;
      allow update: if isVolunteer() && isOwner(resource.data.volunteerId);
      allow delete: if isAdmin();
    }

    // In-App Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.recipientUid == 'PUBLIC');
      allow create, update, delete: if isAdmin();
    }

    // Audit Logs collection (Read-only for Admins, no client write/forgery)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Audit logs must not be writable by clients directly
    }

    // Default deny all other unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
