rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn() && (!hasProfile() || getUserData().get('isActive', true) == true);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return hasProfile() ? getUserData().get('role', 'CITIZEN') : 'CITIZEN';
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'ADMIN';
    }

    function isVolunteer() {
      return isSignedIn() && (getUserRole() == 'VOLUNTEER' || getUserRole() == 'ADMIN');
    }

    function isCitizen() {
      return isActiveUser();
    }


    // --- USERS COLLECTION SECURITY ---
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());

      allow create: if isSignedIn() &&
        isOwner(userId) &&
        request.resource.data.role == 'CITIZEN' &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.get('isActive', true) == true;

      allow update: if (
        isOwner(userId) &&
        isActiveUser() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'isActive'])
      ) || isAdmin();

      allow delete: if isAdmin();
    }


    // --- ALERTS COLLECTION SECURITY ---
    match /alerts/{alertId} {
      // Public users, citizens, and volunteers can read alerts that are public
      // Admins can read all alerts
      allow read: if (resource != null && resource.data.get('isPublic', true) == true) || isAdmin();

      // Only active Admins can create alerts
      allow create: if isAdmin();

      // Only active Admins can update alerts
      allow update: if isAdmin();

      // Deleting alerts is restricted to Admins
      allow delete: if isAdmin();
    }


    // --- INCIDENTS COLLECTION SECURITY ---
    match /incidents/{incidentId} {
      // Citizens can read their own incident reports; Admins and Volunteers can read all
      allow read: if isSignedIn() && (
        (resource != null && isOwner(resource.data.reporterId)) ||
        isAdmin() ||
        isVolunteer()
      );

      // Citizens can create an incident report assigned to their UID with initial status REPORTED
      allow create: if isActiveUser() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'REPORTED';

      // Pre-verification citizen edits: Citizens can edit permitted reporting fields only while status is REPORTED
      // Admins can update status, verification metadata, and resolution notes
      allow update: if (
        isOwner(resource.data.reporterId) &&
        isActiveUser() &&
        resource.data.status == 'REPORTED' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'reporterId',
          'status',
          'verifiedBy',
          'verifiedAt',
          'resolutionNotes',
          'resolvedAt'
        ])
      ) || isAdmin();

      // Only Admins can delete incident records
      allow delete: if isAdmin();
    }


    // --- PLACEHOLDER RESTRICTIVE RULES FOR FUTURE COLLECTIONS ---

    match /emergencyRequests/{requestId} {
      allow read: if isSignedIn() && (isOwner(resource.data.requesterId) || isAdmin() || isVolunteer());
      allow create: if isActiveUser() && request.resource.data.requesterId == request.auth.uid;
      allow update: if (
        isOwner(resource.data.requesterId) &&
        isActiveUser() &&
        resource.data.status == 'PENDING' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'assignedVolunteerId'])
      ) || isVolunteer() || isAdmin();
      allow delete: if isAdmin();
    }

    match /safeLocations/{locationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /volunteers/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isActiveUser() && isOwner(userId);
      allow update: if (
        isOwner(userId) &&
        isActiveUser() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    match /responses/{responseId} {
      allow read: if isSignedIn() && (isOwner(resource.data.volunteerId) || isAdmin());
      allow create: if isVolunteer() && request.resource.data.volunteerId == request.auth.uid;
      allow update: if isVolunteer() && isOwner(resource.data.volunteerId);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || resource.data.recipientUid == 'PUBLIC');
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
